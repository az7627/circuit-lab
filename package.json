{
  "name": "middle-school-circuit-lab",
  "version": "2.8.2",
  "private": true,
  "type": "module",
  "description": "面向中学生的离线电路虚拟实验室",
  "author": "az7627",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/az7627/circuit-lab.git"
  },
  "main": "desktop/main.cjs",
  "engines": {
    "node": ">=22.21.1"
  },
  "scripts": {
    "dev": "node server.mjs",
    "test": "node --test tests/*.test.mjs",
    "check": "node scripts/check.mjs",
    "desktop": "electron .",
    "predesktop:pack": "node scripts/desktop-icons.mjs",
    "desktop:pack": "electron-builder --dir --publish never",
    "predesktop:build": "node scripts/desktop-icons.mjs",
    "desktop:build": "electron-builder --publish never",
    "predesktop:build:win": "node scripts/desktop-icons.mjs",
    "desktop:build:win": "electron-builder --win nsis portable --x64 --publish never",
    "predesktop:build:mac": "node scripts/desktop-icons.mjs",
    "desktop:build:mac": "electron-builder --mac dmg zip --publish never",
    "predesktop:build:linux": "node scripts/desktop-icons.mjs",
    "desktop:build:linux": "electron-builder --linux AppImage deb --x64 --publish never",
    "android:sync": "node scripts/android.mjs sync",
    "android:open": "node scripts/android.mjs open",
    "android:build": "node scripts/android.mjs debug",
    "android:release": "node scripts/android.mjs release",
    "android:bundle": "node scripts/android.mjs bundle",
    "android:ci": "node scripts/android.mjs ci",
    "test:android": "node scripts/android.mjs test",
    "test:desktop": "node scripts/test-desktop.mjs",
    "release:check": "node scripts/release-info.mjs",
    "release:publish": "node scripts/publish-release.mjs",
    "check:git": "node scripts/check-git.mjs"
  },
  "dependencies": {
    "@capacitor/android": "8.5.3",
    "@capacitor/core": "8.5.3"
  },
  "devDependencies": {
    "@capacitor/cli": "8.5.3",
    "@resvg/resvg-js": "2.6.2",
    "electron": "45.0.0",
    "electron-builder": "26.15.3",
    "playwright-core": "1.64.1"
  }
}
